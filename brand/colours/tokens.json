{
  "$description": "Agents One colour tokens in the W3C Design Tokens format. 'palette' holds the raw colours. 'light' and 'dark' map each role to a palette colour. Interfaces use the roles, never the raw colours.",
  "palette": {
    "$type": "color",
    "tide": {
      "50": { "$value": "#EEF8F6" },
      "100": { "$value": "#D3EEEA" },
      "200": { "$value": "#A8DDD5" },
      "300": { "$value": "#72C4B9" },
      "400": { "$value": "#3FA89B" },
      "500": { "$value": "#1F8C80" },
      "600": { "$value": "#137267" },
      "700": { "$value": "#105C54" },
      "800": { "$value": "#0F4944" },
      "900": { "$value": "#0D3B37" },
      "950": { "$value": "#062321" }
    },
    "ember": {
      "100": { "$value": "#FBEBCB" },
      "300": { "$value": "#F6C66B" },
      "400": { "$value": "#F0AE3C" },
      "500": { "$value": "#C27A12" },
      "700": { "$value": "#8F5710" },
      "800": { "$value": "#6B3F0B" },
      "900": { "$value": "#4A2C08" }
    },
    "clay": {
      "100": { "$value": "#FBE3D9" },
      "300": { "$value": "#F29B7C" },
      "600": { "$value": "#A3452A" },
      "800": { "$value": "#7A3220" },
      "900": { "$value": "#4F2216" }
    },
    "stone": {
      "0": { "$value": "#FFFFFF" },
      "25": { "$value": "#F7F7F4" },
      "50": { "$value": "#F4F4F1" },
      "75": { "$value": "#EFEFEA" },
      "100": { "$value": "#E8E8E3" },
      "200": { "$value": "#D4D4CD" },
      "300": { "$value": "#B5B5AD" },
      "500": { "$value": "#7A7A73" },
      "600": { "$value": "#55554F" },
      "700": { "$value": "#41413C" },
      "800": { "$value": "#262624" },
      "850": { "$value": "#1C1C1A" },
      "900": { "$value": "#121211" },
      "950": { "$value": "#0B0B0A" }
    },
    "green": {
      "400": { "$value": "#5DBB63" },
      "700": { "$value": "#2F7D32" }
    },
    "red": {
      "300": { "$value": "#F08A85" },
      "700": { "$value": "#B42F30" }
    },
    "blue": {
      "300": { "$value": "#79A3F0" },
      "700": { "$value": "#2F62C4" }
    }
  },
  "light": {
    "$type": "color",
    "background": { "$value": "{palette.stone.25}" },
    "surface": { "$value": "{palette.stone.0}" },
    "surfaceRaised": { "$value": "{palette.stone.0}" },
    "surfaceSunken": { "$value": "{palette.stone.75}" },
    "border": { "$value": "{palette.stone.200}" },
    "borderStrong": { "$value": "{palette.stone.500}" },
    "text": { "$value": "{palette.stone.850}" },
    "textMuted": { "$value": "{palette.stone.600}" },
    "accent": { "$value": "{palette.tide.600}" },
    "accentHover": { "$value": "{palette.tide.700}" },
    "onAccent": { "$value": "{palette.stone.0}" },
    "accentSubtle": { "$value": "{palette.tide.100}" },
    "onAccentSubtle": { "$value": "{palette.tide.900}" },
    "alive": { "$value": "{palette.ember.500}" },
    "visitor": { "$value": "{palette.clay.600}" },
    "visitorSubtle": { "$value": "{palette.clay.100}" },
    "onVisitorSubtle": { "$value": "{palette.clay.800}" },
    "success": { "$value": "{palette.green.700}" },
    "warning": { "$value": "{palette.ember.700}" },
    "danger": { "$value": "{palette.red.700}" },
    "onDanger": { "$value": "{palette.stone.0}" },
    "info": { "$value": "{palette.blue.700}" },
    "focus": { "$value": "{palette.tide.700}" }
  },
  "dark": {
    "$type": "color",
    "background": { "$value": "{palette.stone.900}" },
    "surface": { "$value": "{palette.stone.850}" },
    "surfaceRaised": { "$value": "{palette.stone.800}" },
    "surfaceSunken": { "$value": "{palette.stone.950}" },
    "border": { "$value": "{palette.stone.700}" },
    "borderStrong": { "$value": "{palette.stone.500}" },
    "text": { "$value": "{palette.stone.50}" },
    "textMuted": { "$value": "{palette.stone.300}" },
    "accent": { "$value": "{palette.tide.400}" },
    "accentHover": { "$value": "{palette.tide.300}" },
    "onAccent": { "$value": "{palette.tide.950}" },
    "accentSubtle": { "$value": "{palette.tide.800}" },
    "onAccentSubtle": { "$value": "{palette.tide.100}" },
    "alive": { "$value": "{palette.ember.400}" },
    "visitor": { "$value": "{palette.clay.300}" },
    "visitorSubtle": { "$value": "{palette.clay.900}" },
    "onVisitorSubtle": { "$value": "{palette.clay.100}" },
    "success": { "$value": "{palette.green.400}" },
    "warning": { "$value": "{palette.ember.400}" },
    "danger": { "$value": "{palette.red.300}" },
    "onDanger": { "$value": "{palette.stone.850}" },
    "info": { "$value": "{palette.blue.300}" },
    "focus": { "$value": "{palette.tide.300}" }
  }
}
